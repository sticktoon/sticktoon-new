# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sticktoon?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here
# Force logout all tokens issued before this Unix timestamp (seconds).
# Keep empty or unset for normal behavior.
JWT_INVALID_BEFORE=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Email Service (Brevo/Sendinblue)
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@sticktoon.shop
FROM_NAME=StickToon

# Payment Gateways
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook
WEBHOOK_BASE_URL=http://localhost:5000

# Admin
ADMIN_EMAIL=admin@sticktoon.shop

# Environment
NODE_ENV=development

# Receipt reading in Revenue → Manual entry (Groq). Backend only: never put
# this key in the root .env, which Vite bundles into the public website.
GROQ_API_KEY=
# Optional. Must be a vision model; change it when Groq retires the model.
GROQ_RECEIPT_MODEL=qwen/qwen3.8-27b

# AYUS ops reads revenue totals from GET /api/ayus/revenue with this in the
# x-ayus-token header. 32+ random characters. Unset = the route is off (404).
AYUS_REVENUE_TOKEN=
